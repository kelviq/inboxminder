{
  "name": "inboxminder",
  "version": "0.10.1",
  "description": "Open-source agent gatekeeper for your inbox. Every email is read locally on your Mac, scored, and triaged with Gmail labels. Nothing is hosted, nothing is sent, your own LLM key.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelviq/inboxminder.git"
  },
  "homepage": "https://inboxminder.com",
  "bin": {
    "inboxminder": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE", "TRADEMARK.md"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --clean",
    "watch": "tsx src/cli.ts watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/openai": "^4.0.27",
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@clack/prompts": "^1.7.0",
    "@napi-rs/keyring": "^1.3.0",
    "ai": "^7.0.48",
    "better-sqlite3": "^13.0.2",
    "commander": "^15.0.0",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "smol-toml": "^1.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
