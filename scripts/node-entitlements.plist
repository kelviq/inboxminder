<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bundled node binary runs V8, which JIT-compiles: under the
     hardened runtime that requires the allow-jit entitlement or the
     process dies at startup on arm64. Scoped to the node binary only;
     the app and native modules are signed without it. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
